# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rmc_booking_system
DB_USERNAME=root
DB_PASSWORD=

# Server
SERVER_PORT=8082
APP_FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT — use a long random secret in production (32+ characters)
JWT_SIGNING_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Maya Checkout (sandbox keys from Maya Manager — never commit real keys)
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_API_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_CHECKOUT_BASE_URL=https://payments-web-sandbox.paymaya.com

# Maya webhook security (enable IP verify in production)
MAYA_WEBHOOK_IP_VERIFY=false
MAYA_WEBHOOK_ALLOWED_IPS=13.229.160.234,3.1.199.75,18.138.50.235,3.1.207.200
MAYA_WEBHOOK_SHARED_SECRET=
MAYA_WEBHOOK_HMAC_SECRET=

# Redis (distributed rate limiting for multi-instance deployments)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Guest booking rate limit (requests per IP per minute; 0 = disabled)
GUEST_BOOKING_RATE_LIMIT=10

# Email (set MAIL_ENABLED=true when SMTP is configured)
MAIL_ENABLED=false
MAIL_FROM=bookings@rmc.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_MINUTES=1
MAIL_OUTBOX_INTERVAL_MS=60000

# Schedulers
SCHEDULER_INTERVAL_MS=60000
